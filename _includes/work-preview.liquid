{% assign work = include.work %}
<article class="work-row{% unless work.image %} work-row--text{% endunless %}" aria-labelledby="work-{{ work.title | slugify }}">
  <div class="work-copy">
    <div class="work-label">
      <span class="work-number" aria-hidden="true"
        ><span class="text-highlight">0{{ include.number }}</span></span
      ><span
        ><span class="text-highlight">{{ work.label }}</span></span
      >
    </div>
    <span class="work-status"
      ><span class="text-highlight">{{ work.status }}</span></span
    >
    {% if include.heading == 'h2' %}
      <h2 id="work-{{ work.title | slugify }}">
        <a href="{{ work.url | relative_url }}"
          ><span class="text-highlight">{{ work.title }}</span></a
        >
      </h2>
    {% else %}
      <h3 id="work-{{ work.title | slugify }}">
        <a href="{{ work.url | relative_url }}"
          ><span class="text-highlight">{{ work.title }}</span></a
        >
      </h3>
    {% endif %}
    <p>
      <span class="text-highlight">{{ work.summary }}</span>
    </p>
    <p class="work-metadata">
      <span class="text-highlight">{{ work.metadata }}</span>
    </p>
    <div class="work-links">
      <a href="{{ work.url | relative_url }}">
        {%- if work.title == 'Reasoning-guided pathology reports' -%}
          <span class="text-highlight">Read about the research</span>
        {%- else -%}
          <span class="text-highlight">Explore project</span>
        {%- endif %}
        <span aria-hidden="true" class="text-highlight">↗</span></a
      >
      {%- if work.code -%}
        <a href="{{ work.code }}"><span class="text-highlight">View code</span> <span aria-hidden="true" class="text-highlight">↗</span></a>
      {%- endif %}
    </div>
  </div>
  {% if work.image %}
    <figure class="work-figure">
      <a class="work-image" href="{{ work.url | relative_url }}"
        ><img
          src="{{ work.image | relative_url }}"
          alt="{{ work.alt }}"
          width="{{ work.width }}"
          height="{{ work.height }}"
          loading="lazy"
          decoding="async"
      ></a>
      <figcaption>
        <span
          ><span class="text-highlight">{{ work.caption }}</span></span
        >
        {%- if work.screenshot -%}
          <a href="{{ work.image | relative_url }}"
            ><span class="text-highlight">Full-size image</span> <span aria-hidden="true" class="text-highlight">↗</span></a
          >
        {%- endif %}
      </figcaption>
    </figure>
  {% endif %}
</article>
