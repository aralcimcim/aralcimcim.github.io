{% if include.kind == 'geometry' %}
  <svg
    class="field-diagram geometry-diagram"
    viewBox="0 0 260 120"
    role="img"
    aria-label="Illustration of a molecular graph rotating while its scalar prediction remains invariant"
  >
    <g class="geometry-rotor" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M78 27 111 46 111 84 78 103 45 84 45 46Z"/><path d="m82 35 21 13m0 32L82 94M53 80V50"/><g class="diagram-nodes"><circle cx="78" cy="27" r="5"/><circle cx="111" cy="46" r="5"/><circle cx="111" cy="84" r="5"/><circle cx="78" cy="103" r="5"/><circle cx="45" cy="84" r="5"/><circle cx="45" cy="46" r="5"/></g></g>
    <path class="diagram-rule" d="M132 63h22m-5-4 5 4-5 4"/><text x="169" y="57" class="diagram-label">f(Rx)</text><text x="169" y="77" class="diagram-label">= f(x)</text>
  </svg>
{% elsif include.kind == 'pathology' %}
  <svg
    class="field-diagram pathology-diagram"
    viewBox="0 0 260 120"
    role="img"
    aria-label="Conceptual whole-slide image pyramid showing slide, region and cell scales"
  >
    <g class="slide-stack" stroke="currentColor" stroke-width="1.2"><path class="slide-base" d="m22 70 58-29 58 29-58 29Z"/><path class="slide-mid" d="m34 51 46-23 46 23-46 23Z"/><path class="slide-top" d="m50 31 30-15 30 15-30 15Z"/></g>
    <path class="diagram-rule" d="M123 53h22l9-14h71"/><g class="cell-tile" transform="translate(165 48)" stroke="currentColor"><rect width="60" height="46" rx="2" fill="none"/><g class="cell-detail"><ellipse cx="17" cy="15" rx="6" ry="9"/><ellipse cx="42" cy="31" rx="7" ry="5"/><ellipse cx="44" cy="12" rx="5" ry="6"/><ellipse cx="17" cy="34" rx="5" ry="4"/></g></g>
    <text x="25" y="114" class="diagram-caption">slide → region</text><text x="166" y="114" class="diagram-caption">→ cells</text>
  </svg>
{% elsif include.kind == 'retrieval' %}
  <svg
    class="field-diagram retrieval-diagram"
    data-retrieval
    tabindex="0"
    viewBox="0 0 260 120"
    role="img"
    aria-label="Conceptual embedding space with a query linked to its three nearest neighbours. Use arrow keys to move the query; Home resets it."
  >
    <g class="embedding-points"><circle data-neighbour cx="28" cy="34" r="3"/><circle data-neighbour cx="46" cy="83" r="3"/><circle data-neighbour cx="67" cy="23" r="3"/><circle data-neighbour cx="91" cy="61" r="3"/><circle data-neighbour cx="108" cy="94" r="3"/><circle data-neighbour cx="117" cy="40" r="3"/><circle data-neighbour cx="150" cy="77" r="3"/><circle data-neighbour cx="167" cy="43" r="3"/><circle data-neighbour cx="190" cy="90" r="3"/><circle data-neighbour cx="201" cy="24" r="3"/><circle data-neighbour cx="227" cy="61" r="3"/><circle data-neighbour cx="78" cy="97" r="3"/></g>
    <g class="retrieval-links" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 3"><line x1="140" y1="56" x2="117" y2="40"/><line x1="140" y1="56" x2="150" y2="77"/><line x1="140" y1="56" x2="167" y2="43"/></g>
    <g class="query-marker" transform="translate(140 56)"><circle r="6"/><text x="10" y="-8" class="diagram-label">q</text></g>
  </svg>
{% endif %}
