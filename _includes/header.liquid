<a class="skip-link" href="#main-content"><span class="text-highlight">Skip to content</span></a>
<header class="portfolio-header">
  <nav class="portfolio-nav container" aria-label="Main navigation">
    <a
      class="portfolio-brand"
      href="{{ '/' | relative_url }}"
      {% if page.url == '/' %}
        aria-current="page"
      {% endif %}
      ><span class="text-highlight">Aral Cimcim</span><span aria-hidden="true" class="text-highlight">.</span></a
    >
    <button
      class="portfolio-menu-toggle collapsed"
      type="button"
      aria-controls="portfolio-menu"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="text-highlight">Menu</span> <span aria-hidden="true" class="text-highlight">+</span>
    </button>
    <div class="portfolio-menu" id="portfolio-menu">
      <a
        href="{{ '/research/' | relative_url }}"
        {% if page.url contains '/research/' or page.category == 'Research' %}
          aria-current="page"
        {% endif %}
        ><span class="text-highlight">Research</span></a
      >
      <a
        href="{{ '/industry/' | relative_url }}"
        {% if page.url contains '/industry/' or page.category == 'Industry' %}
          aria-current="page"
        {% endif %}
        ><span class="text-highlight">Industry</span></a
      >
      <a href="{{ '/' | relative_url }}#about"><span class="text-highlight">About</span></a>
      <a href="mailto:{{ site.data.socials.email }}"><span class="text-highlight">Contact</span></a>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <progress id="progress" value="0" aria-label="Reading progress">
      <div class="progress-container"><span class="progress-bar"></span></div>
    </progress>
  {% endif %}
</header>
