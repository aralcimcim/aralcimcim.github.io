<figure class="molecule-figure" data-molecule-figure aria-labelledby="molecule-caption">
  <div class="figure-meta"><span>COORDINATE DENOISING</span><span data-noise-label>Noise 0%</span></div>
  <svg class="molecule-canvas" viewBox="0 0 480 320" role="img" aria-labelledby="molecule-title molecule-description">
    <title id="molecule-title">From noisy coordinates to a benzene ring</title>
    <desc id="molecule-description">Six carbon atoms settle into a hexagonal ring as coordinate noise decreases. Conceptual illustration, not a trained model output. Hydrogen atoms are omitted.</desc>
    <path class="molecule-reference" d="M335 160 287.5 242.3 192.5 242.3 145 160 192.5 77.7 287.5 77.7Z" fill="none" stroke="currentColor" stroke-dasharray="3 6" opacity="0" aria-hidden="true"/>
    <g class="molecule-bonds" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M335 160 287.5 242.3 192.5 242.3 145 160 192.5 77.7 287.5 77.7Z"/>
      <path d="M320 160 280 229M198 229 158 160M198 91 280 91"/>
    </g>
    <g class="molecule-atoms" aria-hidden="true" text-anchor="middle" dominant-baseline="central">
      <g transform="translate(335 160)"><circle r="14"/><text>C</text></g><g transform="translate(287.5 242.3)"><circle r="14"/><text>C</text></g>
      <g transform="translate(192.5 242.3)"><circle r="14"/><text>C</text></g><g transform="translate(145 160)"><circle r="14"/><text>C</text></g>
      <g transform="translate(192.5 77.7)"><circle r="14"/><text>C</text></g><g transform="translate(287.5 77.7)"><circle r="14"/><text>C</text></g>
    </g>
  </svg>
  <div class="figure-controls" data-molecule-controls hidden>
    <label class="noise-control" for="coordinate-noise"
      >Noise level<input id="coordinate-noise" data-noise-input type="range" min="0" max="100" value="0" step="1"
    ></label>
    <button class="small-control" type="button" data-denoise>Replay denoising</button>
  </div>
  <figcaption id="molecule-caption">
    Noisy coordinates → benzene<span class="figure-footnote">Conceptual illustration · hydrogens omitted.</span>
  </figcaption>
</figure>
